# Copy this file to .env. Never commit a real API key.
LLM_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=z-ai/glm4.7
LLM_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
LLM_PRIMARY_TIMEOUT_SECONDS=30
LLM_FALLBACK_TIMEOUT_SECONDS=120

# Paths are intentionally relative to the project root. Download the datasets and
# model locally, then update these values for your machine.
BGE_M3_MODEL=models/bge-m3
RAG_MODEL=models/bge-m3-finetuned
RAG_INDEX_DIR=data/indexes/lecardv2-finetuned
RAG_RETRIEVAL_MODE=vector_fusion
RAG_FUSION_BASE_MODEL=models/bge-m3
RAG_FUSION_BASE_INDEX_DIR=data/indexes/lecardv2-base
RAG_FUSION_BASE_WEIGHT=0.7
RAG_INDEX_TYPE=hnsw
RAG_HNSW_M=32
RAG_HNSW_EF_CONSTRUCTION=80
RAG_HNSW_EF_SEARCH=64
RAG_RERANKER_MODEL=

